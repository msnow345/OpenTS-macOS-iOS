# Copy to ios-signing.env, which is git-ignored, and fill in.
# scripts/build/ios/package-ios.sh sources it; anything already exported in the shell wins
# over what is set here. Nothing personal belongs in this file's committed copy.

# Apple Developer team id, passed to xcodebuild as DEVELOPMENT_TEAM. This is not the
# identifier in the certificate's parentheses below; passing that one fails with
# "No Account for Team".
export OPENTS_IOS_TEAM_ID=XXXXXXXXXX

# The full codesign identity string, as `security find-identity -v -p codesigning` prints
# it. Use a Development certificate: a Distribution one is for the App Store and will not
# install on a device directly. Never shorten it to "Apple Development" -- once the machine
# holds certificates from more than one team the prefix matches several and codesign fails.
export OPENTS_IOS_CODESIGN_IDENTITY="Apple Development: Your Name (YYYYYYYYYY)"

# CFBundleIdentifier. Unique per team; changing it installs a second, separate app with its
# own data container, so the game data has to be pushed again.
export OPENTS_IOS_BUNDLE_ID=com.example.opents

# Optional. The Identifier column of `xcrun devicectl list devices`, used by --install,
# --launch and --push-data.
export OPENTS_IOS_DEVICE=00000000-0000-0000-0000-000000000000

# Optional, and needed the first time a team registers this device: the hardware UDID that
# xcodebuild -destination wants. It is not the devicectl identifier above. Read it from
# `xcrun devicectl device info details --device <id>` or Xcode's Devices window.
export OPENTS_IOS_DEVICE_UDID=00000000-000000000000000

# Optional bundle metadata. Raise CFBundleVersion when an icon change has to beat
# SpringBoard's icon cache.
# export OPENTS_IOS_BUNDLE_VERSION=1

# Optional app icon controls, see scripts/build/ios/make-icons.sh.
# export OPENTS_IOS_ICON_SOURCE=code/resources/app-icon/opents.svg
# export OPENTS_IOS_ICON_BG=101010
# export OPENTS_IOS_ICON_INSET=0.0
