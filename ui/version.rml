<rml>
<head>
	<title>Version information</title>
	<link type="text/rcss" href="version.rcss"/>
</head>
<body data-model="version" data-event-keydown="key()">
	<div id="dialog">
		<div id="info">
			<div class="line" data-for="line : lines">{{ line }}</div>
		</div>
		<div id="ok" tabindex="auto" data-event-click="dismiss('accept')">OK</div>
	</div>
</body>
</rml>
