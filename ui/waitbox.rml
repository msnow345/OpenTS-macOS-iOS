<rml>
<head>
	<title>Please wait</title>
	<link type="text/rcss" href="optionsbase.rcss"/>
	<link type="text/rcss" href="waitbox.rcss"/>
</head>
<body data-model="waitbox">
	<div id="dialog" class="panel">
		<div id="text">{{ message }}</div>
		<div id="cancel" class="button" data-if="cancancel" data-event-click="cancel()">{{ cancelcaption }}</div>
	</div>
</body>
</rml>
