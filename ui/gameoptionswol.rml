<rml>
<head>
	<title>In-game options</title>
	<link type="text/rcss" href="optionsbase.rcss"/>
	<link type="text/rcss" href="gameoptionswol.rcss"/>
</head>
<body data-model="gameoptionswol" data-event-keydown="key()">
	<div id="dialog" class="panel">
		<div class="button" id="settings" data-event-click="press('settings')">Game Controls</div>
		<div class="button" id="load" data-class-disabled="!canload" data-event-click="press('load')">Load Game</div>
		<div class="button" id="save" data-class-disabled="!cansave" data-event-click="press('save')">Save Game</div>
		<div class="button" id="abort" data-event-click="press('abort')">Abort Mission</div>
		<div class="button" id="resume" data-event-click="press('resume')">[[TXT_RESUME_MISSION]]</div>

		<div id="group">Internet Game Controls</div>

		<div class="caption" id="connectionlabel">Connection</div>
		<input id="connection" class="slider" type="range" orientation="horizontal" min="0" max="3" step="1" data-attr-value="connection" data-event-change="move('connection')"/>
		<div class="caption value" id="connectionvalue">{{ connectionlabel }}</div>

		<div class="caption" id="speedlabel">Game Speed</div>
		<input id="speed" class="slider" type="range" orientation="horizontal" min="0" max="6" step="1" data-attr-value="speed" data-event-change="move('speed')"/>
		<div class="caption value" id="speedvalue">{{ speedlabel }}</div>
	</div>
</body>
</rml>
