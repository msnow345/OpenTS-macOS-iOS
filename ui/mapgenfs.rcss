/* The Firestorm map generator, IDD_MAPGEN_FS: 426 x 242 dialog units, so 639 x 393.25
   pixels. It adds the veinhole bar and the three Firestorm check boxes down the right hand
   side, moves the two sorted combos left, and puts the seed field under the bars. */

#dialog
{
	left: 50%;
	top: 50%;
	margin-left: -319.5dp;
	margin-top: -196.625dp;

	width: 635dp;
	height: 389.25dp;
}

