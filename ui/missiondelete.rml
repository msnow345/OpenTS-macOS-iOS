<rml>
<head>
	<title>Delete mission</title>
	<link type="text/rcss" href="optionsbase.rcss"/>
	<link type="text/rcss" href="savebrowser.rcss"/>
	<link type="text/rcss" href="missiondelete.rcss"/>
</head>
<body data-model="missiondelete" data-event-keydown="key()">
	<div id="dialog" class="panel">
		<div class="caption" id="title">DELETE</div>

		<div class="caption" id="descriptionhead">Description</div>
		<div class="caption" id="timehead">Time Stamp</div>

		<div id="games" class="list">
			<div class="row" data-for="entry : entries" data-class-picked="it_index == selected" data-event-click="pick(it_index)">
				<div class="description">{{ entry.description }}</div>
				<div class="date">{{ entry.date }}</div>
				<div class="time">{{ entry.time }}</div>
			</div>
		</div>

		<div class="button" id="accept" data-class-disabled="!canact" data-event-click="press('accept')">Delete</div>
		<div class="button" id="cancel" data-event-click="press('cancel')">[[TXT_CANCEL]]</div>
	</div>
</body>
</rml>
