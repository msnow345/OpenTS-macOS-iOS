<rml>
<head>
	<title>Join a network game</title>
	<link type="text/rcss" href="optionsbase.rcss"/>
	<link type="text/rcss" href="lobbybase.rcss"/>
	<link type="text/rcss" href="mpguest.rcss"/>
</head>
<body data-model="mpguest" data-event-keydown="key()">
	<div id="dialog" class="panel">
		<div class="caption" id="sidelabel">Your Side:</div>
		<select id="side" class="combo" data-attr-value="selectedside" data-event-change="chooseside()">
			<option data-for="entry : sides" data-attr-value="it_index">{{ entry.name }}</option>
		</select>

		<div class="caption" id="colorlabel">Your Color:</div>
		<select id="color" class="combo" data-attr-value="selectedcolor" data-event-change="choosecolor()">
			<option data-for="swatch : colors" data-attr-value="it_index" data-style-color="swatch.hex">{{ swatch.name }}</option>
		</select>

		<div class="caption" id="maplabel">Map:</div>
		<div class="caption" id="scenarioname">{{ scenarioname }}</div>

		<div class="caption" id="playerslabel">Players:</div>
		<div id="users" class="list users">
			<div class="row" data-for="entry : users">
				<div class="name" data-style-color="entry.hex">{{ entry.name }}</div>
				<div class="side">{{ entry.sidename }}</div>
				<div class="mark">{{ entry.mark }}</div>
			</div>
		</div>

		<div id="messages" class="log">
			<div class="line" data-for="entry : messages" data-style-color="entry.hex">{{ entry.text }}</div>
		</div>

		<input type="text" id="say" class="field" maxlength="255" data-event-keydown="submit()"/>

		<!-- Every game option below is the host's. The template disables all of them on this
		     screen, so they are shown and cannot be touched. -->
		<div class="caption rcaption" id="gamespeedlabel">Game Speed</div>
		<input id="gamespeed" class="slider off" type="range" orientation="horizontal" data-attr-value="gamespeed.value"/>

		<div class="caption rcaption" id="aiplayerslabel">AI Players</div>
		<input id="aiplayers" class="slider off" type="range" orientation="horizontal" data-attr-value="aiplayers.value"/>

		<div class="caption rcaption" id="ailevellabel">AI Level</div>
		<input id="ailevel" class="slider off" type="range" orientation="horizontal" data-attr-value="ailevel.value"/>

		<div class="caption rcaption" id="unitcountlabel">Unit Count</div>
		<input id="unitcount" class="slider off" type="range" orientation="horizontal" data-attr-value="unitcount.value"/>

		<div class="caption rcaption" id="techlevellabel">Tech Level</div>
		<input id="techlevel" class="slider off" type="range" orientation="horizontal" data-attr-value="techlevel.value"/>

		<div class="caption rcaption" id="creditslabel">Credits</div>
		<input id="credits" class="slider off" type="range" orientation="horizontal" data-attr-value="credits.value"/>

		<div class="check off" id="allies" data-class-ticked="allies">Allies allowed</div>
		<div class="check off" id="harvtruce" data-class-ticked="harvtruce">Harvester Truce</div>
		<div class="check off" id="bases" data-class-ticked="bases">Bases</div>
		<div class="check off" id="mcv" data-class-ticked="mcv">Re-Deployable MCV</div>
		<div class="check off" id="fog" data-class-ticked="fog">Fog Of War</div>
		<div class="check off" id="bridges" data-class-ticked="bridges">Bridges Destroyable</div>
		<div class="check off" id="crates" data-class-ticked="crates">Crates</div>
		<div class="check off" id="shortgame" data-class-ticked="shortgame">Short Game</div>
		<div class="check off" id="engineer" data-class-ticked="engineer">Multi Engineer</div>

		<div id="previewframe" class="previewframe">
			<surface data-attr-src="preview"/>
		</div>

		<div class="button" id="cancel" data-event-click="press('cancel')">[[TXT_CANCEL]]</div>
		<div class="button" id="accept" data-class-disabled="!canaccept" data-event-click="press('accept')">Accept</div>
	</div>
</body>
</rml>
